# K'Barré static site configuration for Apache / OVH.
# This file is intentionally independent of the compromised WordPress setup.

DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # The retired client subdomain only has two known, relevant destinations.
  RewriteCond %{HTTP_HOST} ^mon\.kbarre\.fr$ [NC]
  RewriteRule ^confidentialite/?$ https://kbarre.fr/confidentialite/ [R=301,L]
  RewriteCond %{HTTP_HOST} ^mon\.kbarre\.fr$ [NC]
  RewriteRule ^$ https://kbarre.fr/ [R=301,L]

  # Known compromised WordPress URLs must disappear from search results rather
  # than transfer authority to the new site.
  RewriteRule ^~2/l/?$ - [G,L]
  RewriteRule ^2026/08/14/sportivnye-stavki-luchshie-bukmekery-besplatnye-stavki/?$ - [G,L]
  RewriteRule ^2026/08/18/pc-v-android-uecuen-n-son-versiyalar/?$ - [G,L]
  RewriteRule ^2026/08/24/uitgelichte-functies-van-carousel-casino-het-ontdekken-van-de-ongebruikelijke-favorietenlijst/?$ - [G,L]
  RewriteRule ^2026/09/03/ - [G,L]

  # Legacy WordPress URLs kept only where there is a relevant replacement.
  # /realisations and /confidentialite still exist and therefore require no redirect.
  RewriteRule ^prestations/?$ https://kbarre.fr/ [R=301,L]
  RewriteRule ^a-propos/?$ https://kbarre.fr/profil/ [R=301,L]
  RewriteRule ^devis/?$ https://kbarre.fr/contact/ [R=301,L]
  RewriteRule ^references/?$ https://kbarre.fr/realisations/ [R=301,L]
  RewriteRule ^site-vitrine-nantes/?$ https://kbarre.fr/sites-web-premium/ [R=301,L]
  RewriteRule ^sample-page/?$ https://kbarre.fr/ [R=301,L]
  RewriteRule ^cookies/?$ https://kbarre.fr/confidentialite/ [R=301,L]

  # Canonical origin: HTTPS without the www subdomain.
  RewriteCond %{HTTP_HOST} ^www\.kbarre\.fr$ [NC]
  RewriteRule ^ https://kbarre.fr%{REQUEST_URI} [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^kbarre\.fr$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://kbarre.fr%{REQUEST_URI} [R=301,L,NE]

  # Canonical page URLs use a final slash. Files and the site root are excluded.
  RewriteCond %{HTTP_HOST} ^kbarre\.fr$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_URI} !\.[^/]+$
  RewriteRule ^(.+)$ https://kbarre.fr/$1/ [R=301,L,NE]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

  <FilesMatch "\.(?:css|js|mjs|svg|woff2?|avif|webp|png|jpe?g)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
