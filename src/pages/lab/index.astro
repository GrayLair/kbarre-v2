---
import LabLayout from '../../layouts/LabLayout.astro';
---

<LabLayout title="Quatre directions">
  <main class="final-index">
    <header class="final-index__header">
      <a class="final-wordmark" href="/">Ꝃ.barré<span>°</span></a>
      <p>Design lab · quatre directions</p>
    </header>
    <section class="final-index__intro">
      <p class="final-kicker">Identité Ꝃ’Barré — septembre 2026</p>
      <h1>Quatre caractères.<br />Une même promesse.</h1>
      <p>La palette reste identique. Le rythme, la densité, la mise en scène des réalisations et la sensation laissée dès les premières secondes changent radicalement.</p>
    </section>
    <div class="final-index__choices">
      <a class="final-choice final-choice--obys" href="/lab/obys/">
        <span>01 / Éditorial</span><b>Obys</b><p>Le projet comme interface. Direct, curieux, très typographique.</p><i>Explorer ↗</i>
      </a>
      <a class="final-choice final-choice--rejouice" href="/lab/rejouice/">
        <span>02 / Cinématique</span><b>Rejouice</b><p>La promesse comme manifeste. Ample, premium, plus émotionnel.</p><i>Explorer ↗</i>
      </a>
      <a class="final-choice final-choice--folk" href="/lab/folk/">
        <span>03 / Produit</span><b>Folk</b><p>Les expertises comme un système clair. Modulaire, vivant, immédiatement compréhensible.</p><i>Explorer ↗</i>
      </a>
      <a class="final-choice final-choice--signature" href="/lab/signature/">
        <span>04 / Propriétaire</span><b>Signature</b><p>Une identité Ꝃ’Barré autonome. Graphique, contrastée et plus mémorable.</p><i>Explorer ↗</i>
      </a>
    </div>
  </main>
</LabLayout>
