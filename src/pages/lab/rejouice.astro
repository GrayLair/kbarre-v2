---
import LabLayout from '../../layouts/LabLayout.astro';
---

<LabLayout title="Direction Rejouice — Ꝃ’Barré">
  <main class="rejouice-page">
    <header class="final-nav final-nav--dark">
      <a class="final-wordmark" href="/lab/">Ꝃ.barré<span>°</span></a>
      <nav aria-label="Prototype Rejouice"><a href="#approche">Approche</a><a href="#travaux">Travaux</a><a href="#profil-r">Profil</a></nav>
      <a class="final-nav__cta" href="/contact">Parlons-nous ↗</a>
    </header>

    <section class="rejouice-hero" data-spotlight>
      <div class="rejouice-hero__aura" aria-hidden="true"></div>
      <p class="final-kicker">Consultant numérique · Formateur IA · Chef de projet</p>
      <h1>Ꝃ.barré</h1>
      <div class="rejouice-hero__bottom"><p>Stratégie, technologie,<br />transmission.</p><p>Des projets numériques<br />qui servent vraiment.</p><a href="#approche" aria-label="Continuer">↓</a></div>
    </section>

    <section class="rejouice-statement lab-reveal" id="approche"><p class="final-kicker">L’ambition</p><h2>Faire de l’IA et du numérique des leviers qui servent vraiment vos équipes.</h2><div><p>Je transforme les besoins flous en projets clairs, les bons outils en usages durables et les sujets techniques en décisions compréhensibles.</p><a href="/contact">Me parler de votre contexte ↗</a></div></section>

    <section class="rejouice-film lab-reveal" aria-label="Du flou au flux"><div class="rejouice-film__orb" aria-hidden="true"><i></i><i></i><i></i><i></i></div><span>Ꝃ’B / Méthode 01</span><h2>Du flou<br />au flux.</h2><p>Comprendre · Orchestrer · Faire adopter</p></section>

    <section class="rejouice-work" id="travaux">
      <header class="rejouice-section-head lab-reveal"><div><p class="final-kicker">Travaux choisis / 02</p><h2>Les réalisations parlent mieux lorsqu’on leur laisse de la place.</h2></div><a href="/realisations">Toutes les réalisations ↗</a></header>
      <div class="rejouice-cases">
        <a class="rejouice-case rejouice-case--wide lab-reveal" href="/realisations"><div><img src="/images/projects/virginia-immobilier.webp" width="768" height="902" alt="Aperçu de Virginia Immobilier" loading="lazy" decoding="async" /></div><footer><h3>Virginia Immobilier</h3><p>Immobilier · Projet numérique</p><span>01</span></footer></a>
        <a class="rejouice-case lab-reveal" href="/realisations"><div><img src="/images/projects/romy-paris.webp" width="768" height="790" alt="Aperçu de Romy Paris" loading="lazy" decoding="async" /></div><footer><h3>Romy Paris</h3><p>Beauté · E-commerce</p><span>02</span></footer></a>
        <a class="rejouice-case lab-reveal" href="/realisations"><div><img src="/images/projects/oxygene-consulting.webp" width="1024" height="862" alt="Aperçu d’Oxygène Consulting" loading="lazy" decoding="async" /></div><footer><h3>Oxygène Consulting</h3><p>Conseil · Site Web</p><span>03</span></footer></a>
      </div>
    </section>

    <section class="rejouice-glance">
      <header class="lab-reveal"><p class="final-kicker">Kévin en bref / 03</p><h2>Un profil hybride.<br />Une exécution solide.</h2></header>
      <div class="rejouice-stats">
        <article class="lab-reveal"><strong>15+</strong><p>années dans<br />le numérique</p></article>
        <article class="lab-reveal"><strong>150 k€</strong><p>de budget projet<br />déjà piloté</p></article>
        <article class="lab-reveal"><strong>15</strong><p>personnes<br />coordonnées</p></article>
        <article class="lab-reveal"><strong>FR/EN</strong><p>communication<br />bilingue C2</p></article>
      </div>
    </section>

    <section class="rejouice-services">
      <p class="final-kicker lab-reveal">Trois terrains d’action / 04</p>
      <a class="lab-reveal" href="/ia-automatisation"><span>01</span><h3>IA & automatisation</h3><b>↗</b></a>
      <a class="lab-reveal" href="/pilotage-digital"><span>02</span><h3>Pilotage de projet</h3><b>↗</b></a>
      <a class="lab-reveal" href="/sites-web-premium"><span>03</span><h3>Expériences Web</h3><b>↗</b></a>
    </section>

    <section class="rejouice-profile lab-reveal" id="profil-r"><div class="rejouice-profile__copy"><p class="final-kicker">Le profil / 05</p><h2>Relier les points est devenu mon métier.</h2><p>Je travaille à l’intersection des équipes, des outils et des décisions. Mon rôle : donner une direction commune et rendre l’exécution plus simple.</p><a href="/profil">Découvrir le parcours ↗</a></div><figure><img src="/images/kevin-barre.jpg" width="350" height="465" alt="Kévin Barré" loading="lazy" decoding="async" /><figcaption>Nantes · France · Missions & postes</figcaption></figure></section>

    <section class="rejouice-contact lab-reveal"><p>Un projet. Un poste. Une idée.</p><a href="/contact">Faisons-le bien,<br />dès le départ. <span>↗</span></a></section>
    <footer class="final-footer final-footer--dark"><span>Direction 02 — Rejouice</span><a href="/lab/obys">← Voir Obys</a><a href="/lab/folk">Voir Folk →</a></footer>
  </main>

  <script is:inline>
    const spotlight = document.querySelector('[data-spotlight]');
    if (spotlight && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      spotlight.addEventListener('pointermove', (event) => {
        const bounds = spotlight.getBoundingClientRect();
        spotlight.style.setProperty('--pointer-x', ((event.clientX - bounds.left) / bounds.width * 100) + '%');
        spotlight.style.setProperty('--pointer-y', ((event.clientY - bounds.top) / bounds.height * 100) + '%');
      });
    }
  </script>
</LabLayout>
