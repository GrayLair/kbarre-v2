---
import LabLayout from '../../layouts/LabLayout.astro';

const projects = [
  { name: 'Virginia Immobilier', sector: 'Immobilier', role: 'Projet numérique · intégration', image: '/images/projects/virginia-immobilier.webp', width: 768, height: 902 },
  { name: 'Romy Paris', sector: 'Beauté', role: 'E-commerce · expérience Web', image: '/images/projects/romy-paris.webp', width: 768, height: 790 },
  { name: 'Oxygène Consulting', sector: 'Conseil', role: 'Positionnement · site Web', image: '/images/projects/oxygene-consulting.webp', width: 1024, height: 862 },
  { name: 'Genicado', sector: 'E-commerce', role: 'Conception · intégration', image: '/images/projects/genicado.webp', width: 768, height: 970 },
  { name: 'Turgis Capital', sector: 'Finance', role: 'Pilotage · présence en ligne', image: '/images/projects/turgis-capital.webp', width: 768, height: 1058 },
];
---

<LabLayout title="Direction Obys — Ꝃ’Barré">
  <main class="obys-page">
    <header class="final-nav final-nav--light">
      <a class="final-wordmark" href="/lab/">Ꝃ.barré<span>°</span></a>
      <nav aria-label="Prototype Obys"><a href="#realisations">Réalisations</a><a href="#expertises">Expertises</a><a href="#profil">Profil</a></nav>
      <a class="final-nav__cta" href="/contact">Parlons-nous ↗</a>
    </header>

    <section class="obys-hero">
      <div class="obys-hero__meta"><span>Consultant numérique</span><span>Formateur IA</span><span>Nantes · France</span></div>
      <h1><span>Les projets</span><span>ne sont jamais</span><span>« juste » des projets.</span></h1>
      <div class="obys-hero__foot"><p>Ils sont le point de rencontre d’un enjeu métier, d’une équipe et d’un système à faire fonctionner.</p><a href="#realisations">Voir la sélection <i>↓</i></a></div>
    </section>

    <div class="final-marquee" aria-hidden="true"><div><span>IA utile</span><i>✦</i><span>Pilotage de projet</span><i>✦</i><span>Sites Web</span><i>✦</i><span>Automatisation</span><i>✦</i><span>IA utile</span><i>✦</i><span>Pilotage de projet</span><i>✦</i><span>Sites Web</span><i>✦</i><span>Automatisation</span><i>✦</i></div></div>

    <section class="obys-manifesto lab-reveal">
      <p class="final-kicker">Mon rôle / 01</p>
      <h2>Je transforme les besoins flous en décisions claires, puis les décisions en mouvement.</h2>
      <div><p>Chef de projet, intégrateur, consultant et formateur : je relie les disciplines pour éviter les silos, les outils mal choisis et les projets qui s’essoufflent.</p><a href="/profil">Découvrir mon profil ↗</a></div>
    </section>

    <section class="obys-projects" id="realisations">
      <header class="obys-projects__head lab-reveal"><div><p class="final-kicker">Réalisations choisies / 02</p><h2>Une sélection courte.<br />Des contextes très différents.</h2></div><div class="obys-view" aria-label="Affichage des projets"><button class="is-active" type="button" data-view="list">Index</button><button type="button" data-view="grid">Grille</button></div></header>
      <div class="obys-projects__body">
        <div class="obys-project-list">
          {projects.map((project, index) => (
            <a class="obys-project-row lab-reveal" href="/realisations" data-project={index}>
              <span>{String(index + 1).padStart(2, '0')}</span><h3>{project.name}</h3><p>{project.sector}</p><p>{project.role}</p><b>↗</b>
              <img class="obys-row-image" src={project.image} width={project.width} height={project.height} alt={'Aperçu du projet ' + project.name} loading="lazy" decoding="async" />
            </a>
          ))}
          <a class="obys-project-row obys-project-row--text lab-reveal" href="/realisations"><span>06</span><h3>Active Square</h3><p>Conseil</p><p>Accompagnement · mise en mouvement</p><b>↗</b></a>
        </div>
        <div class="obys-preview" aria-hidden="true">
          {projects.map((project, index) => <img class={index === 0 ? 'is-active' : ''} src={project.image} width={project.width} height={project.height} alt="" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" data-preview={index} />)}
          <span>Survoler l’index</span>
        </div>
      </div>
    </section>

    <section class="obys-expertise" id="expertises">
      <header class="lab-reveal"><p class="final-kicker">Expertises / 03</p><h2>Un profil transversal pour faire avancer l’ensemble.</h2></header>
      <div class="obys-expertise__list">
        <article class="lab-reveal"><span>01</span><h3>IA & automatisation</h3><p>Formation, prompting, agents, workflows et gouvernance des usages.</p><a href="/ia-automatisation">Explorer ↗</a></article>
        <article class="lab-reveal"><span>02</span><h3>Pilotage de projet</h3><p>Cadrage, coordination, analyse fonctionnelle et accompagnement au changement.</p><a href="/pilotage-digital">Explorer ↗</a></article>
        <article class="lab-reveal"><span>03</span><h3>Expériences Web</h3><p>Architecture, conception, intégration et performance technique.</p><a href="/sites-web-premium">Explorer ↗</a></article>
      </div>
    </section>

    <section class="obys-profile lab-reveal" id="profil">
      <div class="obys-profile__portrait"><img src="/images/kevin-barre.jpg" width="350" height="465" alt="Kévin Barré" loading="lazy" decoding="async" /><span>Disponible pour de nouveaux défis</span></div>
      <div class="obys-profile__copy"><p class="final-kicker">À propos / 04</p><h2>Assez technique pour dialoguer.<br />Assez métier pour décider.</h2><p>Plus de quinze ans à naviguer entre produit, communication, gestion de projet et Web. Aujourd’hui, j’ajoute l’orchestration IA à cette culture du concret.</p><a href="/profil">Lire le parcours complet ↗</a></div>
    </section>

    <section class="obys-contact lab-reveal"><p>Un sujet à clarifier ?</p><a href="/contact">Commençons par<br />une conversation. <span>↗</span></a></section>
    <footer class="final-footer"><span>Direction 01 — Obys</span><a href="/lab/">Voir les 4 directions</a><a href="/lab/rejouice">Voir Rejouice →</a></footer>
  </main>

  <script is:inline>
    const projectSection = document.querySelector('.obys-projects');
    document.querySelectorAll('[data-project]').forEach((row) => {
      const activate = () => document.querySelectorAll('[data-preview]').forEach((preview) => preview.classList.toggle('is-active', preview.dataset.preview === row.dataset.project));
      row.addEventListener('mouseenter', activate);
      row.addEventListener('focus', activate);
    });
    document.querySelectorAll('[data-view]').forEach((button) => button.addEventListener('click', () => {
      projectSection?.classList.toggle('is-grid', button.dataset.view === 'grid');
      document.querySelectorAll('[data-view]').forEach((item) => item.classList.toggle('is-active', item === button));
    }));
  </script>
</LabLayout>
