---
import BaseLayout from '../layouts/BaseLayout.astro';
import PracticeNotes from '../components/PracticeNotes.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SeoFaq from '../components/SeoFaq.astro';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Orchestration multi-agents IA sous contrôle humain',
  description: 'Conception de systèmes de travail multi-agents avec rôles spécialisés, exécution parallèle, validation indépendante et responsabilité humaine explicite.',
  provider: {
    '@type': 'Person',
    name: 'Kévin Barré',
    url: 'https://kbarre.fr',
  },
  areaServed: ['Nantes', 'France'],
  serviceType: ['Orchestration IA', 'Agents IA', 'Automatisation', 'Pilotage de projet assisté par IA'],
};
---

<BaseLayout
  title="Orchestration multi-agents IA · sous contrôle humain"
  description="Orchestration multi-agents : répartir les rôles, paralléliser ce qui peut l’être, vérifier les résultats et garder une autorité humaine claire."
  structuredData={serviceSchema}
>
  <PageHero
    eyebrow="Orchestration multi-agents"
    title="Plusieurs agents. Une seule responsabilité."
    text="Un système multi-agents devient utile quand un projet demande plusieurs types de travail, plusieurs contextes et plusieurs niveaux de contrôle. Les agents peuvent exécuter en parallèle ; la responsabilité, elle, reste humaine."
    aside="Je conçois l’orchestration comme un système de livraison : rôles bornés, dépendances visibles, validation séparée de la production et décision humaine aux points qui comptent."
    ctaHref="/contact/?demande=ia"
    ctaLabel="Parler d’un système agentique"
    visual="/images/heroes/ai-automation.png"
    visualAlt="Interface représentant un workflow d’automatisation et d’agents IA"
    visualWidth={1122}
    visualHeight={1402}
    motif="/images/kit/interface-map.svg"
  />

  <section class="section section--night">
    <div class="shell">
      <SectionHeading
        eyebrow="Le changement de perspective"
        title="Ne pas demander à un seul agent de tout porter."
        text="Recherche, implémentation, contrôle, documentation et arbitrage n’ont pas les mêmes besoins de contexte ni les mêmes critères de réussite."
        align="split"
      />
      <div class="service-grid service-grid--four">
        <article class="service-card">
          <span class="service-card__number">01</span>
          <h3>Spécialiser les rôles</h3>
          <p>Chaque agent reçoit une responsabilité bornée et un résultat attendu, au lieu de mélanger tous les sujets dans une seule conversation.</p>
        </article>
        <article class="service-card">
          <span class="service-card__number">02</span>
          <h3>Paralléliser avec discernement</h3>
          <p>Les travaux réellement indépendants avancent en parallèle. Les dépendances restent explicites pour éviter une convergence tardive et conflictuelle.</p>
        </article>
        <article class="service-card">
          <span class="service-card__number">03</span>
          <h3>Séparer produire et vérifier</h3>
          <p>Un résultat généré reste une proposition tant qu’il n’a pas passé la revue ou la validation adaptée au risque concerné.</p>
        </article>
        <article class="service-card">
          <span class="service-card__number">04</span>
          <h3>Garder l’autorité humaine</h3>
          <p>Objectifs, priorités, arbitrages, exceptions et acceptation finale restent sous la responsabilité d’une personne identifiable.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--muted" id="systeme-livraison">
    <div class="shell">
      <SectionHeading
        eyebrow="Un système de livraison"
        title="De l’objectif à la décision, chaque rôle a une frontière."
        text="Le schéma ci-dessous est volontairement générique : il montre la logique publique sans reproduire une architecture ou un contrat privé."
        align="split"
      />
      <figure class="orchestration-map" aria-labelledby="orchestration-map-title">
        <figcaption id="orchestration-map-title">Exemple générique d’un flux multi-agents sous contrôle humain.</figcaption>
        <div class="orchestration-map__owner">
          <span>Autorité humaine</span>
          <strong>Objectif · priorité · critères d’acceptation</strong>
          <p>Le cadre de décision est fixé avant de distribuer l’exécution.</p>
        </div>
        <div class="orchestration-map__roles" aria-label="Rôles spécialisés">
          <article><span>Rôle A</span><strong>Explorer</strong><p>Rechercher, comparer, identifier les inconnues.</p></article>
          <article><span>Rôle B</span><strong>Produire</strong><p>Implémenter ou construire un livrable borné.</p></article>
          <article><span>Rôle C</span><strong>Contrôler</strong><p>Relire, tester ou challenger indépendamment.</p></article>
        </div>
        <div class="orchestration-map__gate">
          <span>Convergence</span>
          <strong>Résultats rapprochés, dépendances relues, écarts visibles</strong>
        </div>
        <div class="orchestration-map__decision">
          <span>Décision humaine</span>
          <strong>Accepter · demander une reprise · arbitrer l’exception</strong>
        </div>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeading
        eyebrow="Le parallèle a des limites"
        title="Plus d’agents ne signifie pas automatiquement plus de vitesse."
        text="La parallélisation n’a de valeur que lorsque les travaux sont suffisamment indépendants et que leur convergence est maîtrisée."
        align="split"
      />
      <ol class="process-list">
        <li><span>01</span><strong>Identifier les frontières</strong><p>Avant de distribuer le travail, je sépare ce qui peut évoluer indépendamment de ce qui partage une décision, une interface ou une donnée critique.</p></li>
        <li><span>02</span><strong>Limiter le contexte de chaque rôle</strong><p>Un agent reçoit ce qui est nécessaire à sa mission, pas l’intégralité du projet par défaut. Ce découpage vise à garder les responsabilités lisibles et à rendre la revue plus explicite.</p></li>
        <li><span>03</span><strong>Prévoir la convergence</strong><p>Le moment où les travaux se rejoignent est traité comme une étape à part entière : compatibilité, conflits, écarts de compréhension et validation.</p></li>
        <li><span>04</span><strong>Escalader ce qui exige un arbitrage</strong><p>Une dépendance ambiguë ou une exception importante ne doit pas être “résolue” silencieusement par un agent. Elle revient au niveau de décision approprié.</p></li>
      </ol>
    </div>
  </section>

  <section class="section section--night">
    <div class="shell">
      <SectionHeading
        eyebrow="Production ≠ acceptation"
        title="Un agent peut produire. Il ne s’auto-valide pas."
        text="Je traite la séparation entre exécution et vérification comme un garde-fou central d’un système agentique."
        align="split"
      />
      <div class="service-scope">
        <article>
          <p class="eyebrow">Exécution</p>
          <h3>Produire un résultat borné.</h3>
          <p>Le rôle d’exécution travaille sur une mission précise : recherche, code, analyse, documentation ou transformation de contenu. Sa sortie reste un candidat à l’acceptation.</p>
        </article>
        <article>
          <p class="eyebrow">Vérification</p>
          <h3>Contrôler avec un autre angle.</h3>
          <p>Selon le risque, un autre rôle peut relire, tester, comparer aux critères ou chercher les défauts. La validation peut être automatisée, humaine ou combiner les deux.</p>
        </article>
      </div>
      <div class="editorial-copy editorial-copy--night">
        <p>Cette distinction évite de traiter une réponse bien formulée comme une preuve suffisante par défaut. Le niveau de contrôle doit rester proportionné à l’impact du travail.</p>
      </div>
    </div>
  </section>

  <section class="section section--muted">
    <div class="shell">
      <SectionHeading
        eyebrow="Autorité humaine"
        title="Ce que l’humain ne délègue pas."
        text="L’orchestration augmente la surface d’exécution ; elle ne déplace pas la responsabilité finale vers le système."
        align="split"
      />
      <div class="service-grid">
        <article class="service-card">
          <span class="service-card__number">A</span>
          <h3>Le but et les priorités</h3>
          <p>Décider ce qui mérite d’être fait, ce qui peut attendre et quels compromis sont acceptables reste une responsabilité humaine.</p>
        </article>
        <article class="service-card">
          <span class="service-card__number">B</span>
          <h3>Les exceptions</h3>
          <p>Quand la situation sort du cadre prévu, l’escalade vaut mieux qu’une improvisation autonome présentée comme certaine.</p>
        </article>
        <article class="service-card">
          <span class="service-card__number">C</span>
          <h3>L’acceptation</h3>
          <p>Le fait qu’un agent ait terminé une mission ne signifie pas que le projet doit accepter automatiquement son résultat.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeading
        eyebrow="Quand l’orchestration devient pertinente"
        title="Quand le travail comporte plusieurs rôles, pas simplement plusieurs prompts."
        text="Un seul assistant reste souvent le meilleur choix pour une tâche isolée. L’orchestration devient intéressante lorsque le travail doit être distribué, contrôlé et recomposé."
        align="split"
      />
      <div class="service-scope">
        <article>
          <p class="eyebrow">Produit & projet numérique</p>
          <h3>Recherche, implémentation, revue et documentation.</h3>
          <p>Plusieurs responsabilités peuvent progresser de manière coordonnée tout en conservant des points de contrôle et des critères d’acceptation communs.</p>
        </article>
        <article>
          <p class="eyebrow">Audit & reprise</p>
          <h3>Explorer l’existant sans écraser les incertitudes.</h3>
          <p>Des rôles distincts peuvent inventorier, analyser et challenger un état existant avant qu’une décision de modification soit prise.</p>
        </article>
      </div>
      <div class="editorial-copy">
        <p>Je ne présente pas l’orchestration comme une promesse de productivité chiffrée par défaut. Sa valeur dépend du type de travail, de la qualité du découpage, des dépendances et du niveau de contrôle nécessaire.</p>
        <a class="text-link" href="/ia-automatisation/">Revenir à l’offre IA & automatisation <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="section section--night">
    <div class="shell">
      <SectionHeading
        eyebrow="Ce que ce n’est pas"
        title="Pas une entreprise autonome miniature."
        text="Ajouter des agents ne supprime ni la gouvernance, ni les dépendances, ni le besoin de jugement."
        align="split"
      />
      <ol class="process-list">
        <li><span>—</span><strong>Pas d’acceptation automatique</strong><p>Une sortie générée n’est pas promue en vérité de projet uniquement parce qu’un agent l’a produite.</p></li>
        <li><span>—</span><strong>Pas de multiplication aveugle des agents</strong><p>Un rôle supplémentaire doit résoudre un problème de contexte, de spécialisation, de contrôle ou de parallélisation identifiable.</p></li>
        <li><span>—</span><strong>Pas de promesse de vitesse universelle</strong><p>Certaines tâches se parallélisent très bien ; d’autres sont séquentielles ou demandent d’abord une décision humaine.</p></li>
        <li><span>—</span><strong>Pas de responsabilité diffuse</strong><p>Les objectifs et l’acceptation doivent toujours rester attribués à une personne ou une organisation responsable.</p></li>
      </ol>
    </div>
  </section>

  <SeoFaq
    eyebrow="Questions fréquentes"
    title="À propos de l’orchestration multi-agents."
    intro="Le bon système est rarement celui qui contient le plus d’agents. C’est celui dont les rôles et les contrôles correspondent au travail réel."
    items={[
      {
        question: 'Quelle différence avec utiliser simplement ChatGPT ou un autre assistant ?',
        answer: 'Pour une tâche isolée, un seul assistant suffit souvent. L’orchestration devient utile lorsque plusieurs responsabilités doivent travailler avec des contextes différents, parfois en parallèle, puis converger vers une validation commune.',
      },
      {
        question: 'Les agents peuvent-ils travailler entièrement seuls ?',
        answer: 'Ils peuvent exécuter des missions bornées avec différents degrés d’autonomie technique. Les objectifs, arbitrages importants, exceptions et critères d’acceptation restent sous autorité humaine.',
      },
      {
        question: 'Est-ce forcément plus rapide ?',
        answer: 'Non. Des travaux réellement indépendants peuvent avancer sans attendre les autres, mais l’orchestration ajoute aussi du contrôle et de la coordination. La valeur doit être évaluée selon le cas d’usage, pas supposée.',
      },
      {
        question: 'Peut-on intégrer cette approche aux outils existants ?',
        answer: 'Oui, lorsque les outils disposent des interfaces et droits adaptés. Le point de départ reste le flux de travail et les responsabilités, pas l’ajout d’une couche agentique pour elle-même.',
      },
    ]}
  />

  <section class="section section--purple">
    <div class="shell">
      <div class="callout">
        <div>
          <p class="eyebrow">Un travail complexe à distribuer</p>
          <h2>Commençons par décider ce qui mérite réellement d’être orchestré.</h2>
        </div>
        <a class="button button--light" href="/contact/?demande=ia">Échanger sur le besoin <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
  <PracticeNotes focus="ai" />
</BaseLayout>
