---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { caseStudies, portfolioReferences, caseStudyPath, getCaseStudyById } from '../data/case-studies';

const featuredStudies = caseStudies;
---

<BaseLayout
  title="Réalisations Web, numériques et créatives"
  description="Études de cas et références Web et numériques de Kévin Barré : contribution documentée, rôle explicite et limites de preuve."
>
  <PageHero
    eyebrow="Réalisations"
    title="Des projets, avec leur contexte et leur niveau de preuve."
    text="Les études de cas détaillent ce que je peux réellement attribuer à mon intervention. Les autres références restent volontairement plus courtes lorsque la preuve disponible ne justifie pas davantage."
    visual="/images/heroes/creative-direction.png"
    visualAlt="Mur de références visuelles, de maquettes et d’interfaces"
    visualWidth={1672}
    visualHeight={941}
    motif="/images/kit/design-grid.svg"
  />

  <section class="section section--night">
    <div class="shell">
      <SectionHeading
        eyebrow="Études de cas"
        title="Contexte. Contribution. Preuve."
        text="Une fiche détaillée n’existe que lorsque le projet dispose d’éléments suffisants pour distinguer mon rôle, ce qui peut être démontré et ce qui ne doit pas être revendiqué."
        align="split"
      />
      <div class="case-study-grid">
        {featuredStudies.map((study, index) => {
          const copy = study.copy.fr;
          return (
            <a class="case-study-card" href={caseStudyPath('fr', study)}>
              <div class="case-study-card__media">
                <img
                  src={study.image.src}
                  srcset={study.image.srcset}
                  sizes="(max-width: 760px) 92vw, 42vw"
                  width={study.image.width}
                  height={study.image.height}
                  alt={study.image.alt.fr}
                  loading={index < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </div>
              <div class="case-study-card__body">
                <div class="case-study-card__meta">
                  <span>{study.category.fr}</span>
                  <span>{study.role.fr}</span>
                </div>
                <h3>{copy.title}</h3>
                <p>{copy.summary}</p>
                <span class="text-link">Lire l’étude de cas <span aria-hidden="true">↗</span></span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section section--muted">
    <div class="shell">
      <SectionHeading
        eyebrow="Références sélectionnées"
        title="Toutes les références n’ont pas le même niveau de détail."
        text="Ces projets sont déjà publics dans le portfolio. Les formulations restent proportionnées aux éléments disponibles : certaines renvoient vers une étude de cas, d’autres restent des références simples."
        align="split"
      />
      <div class="project-showcase">
        {portfolioReferences.map((project, index) => {
          const detail = project.detailId ? getCaseStudyById(project.detailId) : undefined;
          return (
            <article id={project.id} class:list={['project-showcase__item', 'project-showcase__item--' + index]}>
              <div class="project-showcase__image">
                <img
                  src={project.image}
                  srcset={project.image.replace('/projects/', '/optimized/').replace('.webp', '-480.webp') + ' 480w, ' + project.image.replace('/projects/', '/optimized/').replace('.webp', '-768.webp') + ' 768w'}
                  sizes="(max-width: 760px) calc(100vw - 5.5rem), (max-width: 1440px) 42vw, 580px"
                  width={project.width}
                  height={project.height}
                  alt={'Aperçu du projet ' + project.name}
                  loading={index < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                />
                <span>{String(index + 1).padStart(2, '0')}</span>
              </div>
              <div class="project-showcase__meta"><p>{project.category.fr}</p><p>{project.role.fr}</p></div>
              <h3>{project.name}</h3>
              <p class="project-showcase__text">{project.text.fr}</p>
              {detail && <a class="text-link" href={caseStudyPath('fr', detail)}>Voir l’étude de cas <span aria-hidden="true">↗</span></a>}
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeading
        eyebrow="Pourquoi cette prudence"
        title="Un portfolio ne doit pas transformer une participation en propriété."
        text="Je préfère une référence courte mais exacte à un récit plus impressionnant qui attribuerait des résultats, une direction créative ou un périmètre que je ne peux pas étayer."
        align="split"
      />
      <div class="service-scope">
        <article>
          <p class="eyebrow">Projet public documenté</p>
          <h3>Une étude de cas détaillée.</h3>
          <p>Le contexte, ma contribution et les éléments démontrables peuvent être présentés, avec une limite de preuve explicite.</p>
        </article>
        <article>
          <p class="eyebrow">Preuve limitée</p>
          <h3>Une référence reste une référence.</h3>
          <p>Le nom et le visuel peuvent rester publics sans inventer un résultat ou un rôle plus large que ce qui est réellement documenté.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeading
        eyebrow="Création média"
        title="Un portfolio qui s’ouvre aussi au son et à l’image."
        text="La création musicale et multimédia fait partie de la pratique de Kévin Barré au même titre que le Web et le pilotage. Pour chaque œuvre publiée, le contexte, les outils employés et la part de création assistée par IA doivent être explicités."
        align="split"
      />
      <a class="text-link" href="/creation-media-ia/">Découvrir la pratique créative <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="section section--purple">
    <div class="shell">
      <div class="callout">
        <div>
          <p class="eyebrow">Un projet à documenter</p>
          <h2>Parlons de la forme que doit prendre le vôtre.</h2>
        </div>
        <a class="button button--light" href="/contact/">Prendre contact <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
