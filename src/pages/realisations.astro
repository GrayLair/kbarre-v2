---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';

const projects = [
  {
    number: '01',
    name: 'Virginia Immobilier',
    category: 'Immobilier',
    role: 'Projet numérique · intégration',
    text: 'Une présence en ligne dans l’immobilier, présentée ici pour la partie projet et intégration.',
    image: '/images/projects/virginia-immobilier.webp',
    width: 768,
    height: 902,
  },
  {
    number: '02',
    name: 'Romy Paris',
    category: 'Beauté',
    role: 'E-commerce · expérience Web',
    text: 'Un projet e-commerce dans l’univers de la beauté, où l’expérience Web et la présentation de l’offre tiennent une place centrale.',
    image: '/images/projects/romy-paris.webp',
    width: 768,
    height: 790,
  },
  {
    number: '03',
    name: 'Oxygène Consulting',
    category: 'Conseil',
    role: 'Positionnement · site Web',
    text: 'Une présence Web conçue pour une activité de conseil : rendre l’offre lisible et donner une forme cohérente au positionnement.',
    image: '/images/projects/oxygene-consulting.webp',
    width: 1024,
    height: 862,
  },
  {
    number: '04',
    name: 'Genicado',
    category: 'E-commerce',
    role: 'Conception · intégration',
    text: 'Un projet e-commerce qui illustre le travail de conception et d’intégration d’une interface orientée vers les contenus et les usages.',
    image: '/images/projects/genicado.webp',
    width: 768,
    height: 970,
  },
  {
    number: '05',
    name: 'Turgis Capital',
    category: 'Finance',
    role: 'Pilotage · présence en ligne',
    text: 'Une présence en ligne dans le secteur financier, avec une contribution de pilotage et de structuration de la communication en ligne.',
    image: '/images/projects/turgis-capital.webp',
    width: 768,
    height: 1058,
  },
];
---

<BaseLayout
  title="Réalisations Web, numériques et créatives"
  description="Une sélection de réalisations Web et numériques de Kévin Barré : immobilier, e-commerce, conseil, finance et création média."
>
  <PageHero
    eyebrow="Réalisations"
    title="Des projets, avec leur contexte."
    text="Une sélection de collaborations Web et numériques. Chaque aperçu indique la nature de la contribution : conception, intégration, positionnement ou pilotage."
    visual="/images/heroes/creative-direction.png"
    visualAlt="Mur de références visuelles, de maquettes et d’interfaces"
    visualWidth={1672}
    visualHeight={941}
    motif="/images/kit/design-grid.svg"
  />

  <section class="section section--muted">
    <div class="shell">
      <SectionHeading
        eyebrow="Sélection de réalisations"
        title="Ce qui compte derrière une interface."
        text="Une image montre une direction visuelle ; elle ne raconte pas tout le travail. Cette sélection précise donc le rôle tenu et le type de sujet traité, sans attribuer de résultats qui ne seraient pas documentés."
        align="split"
      />
      <div class="project-showcase">
        {projects.map((project, index) => (
          <article id={project.image.split('/').pop()?.replace('.webp', '')} class:list={['project-showcase__item', 'project-showcase__item--' + index]}>
            <div class="project-showcase__image">
              <img src={project.image} srcset={project.image.replace('/projects/', '/optimized/').replace('.webp', '-480.webp') + ' 480w, ' + project.image.replace('/projects/', '/optimized/').replace('.webp', '-768.webp') + ' 768w'} sizes="(max-width: 760px) calc(100vw - 5.5rem), (max-width: 1440px) 42vw, 580px" width={project.width} height={project.height} alt={'Aperçu du projet ' + project.name} loading={index < 2 ? 'eager' : 'lazy'} decoding="async" />
              <span>{project.number}</span>
            </div>
            <div class="project-showcase__meta"><p>{project.category}</p><p>{project.role}</p></div>
            <h3>{project.name}</h3>
            <p class="project-showcase__text">{project.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeading
        eyebrow="Création média"
        title="Un portfolio qui s’ouvre aussi au son et à l’image."
        text="La création musicale et multimédia fait partie de la pratique de Kévin Barré au même titre que le Web et le pilotage. Pour chaque œuvre publiée, le contexte, les outils employés et la part de création assistée par IA doivent être explicités."
        align="split"
      />
      <a class="text-link" href="/creation-media-ia/">Découvrir la pratique créative <span aria-hidden="true">↗</span></a>
    </div>
  </section>

<section class="section section--purple">
    <div class="shell">
      <div class="callout">
        <div>
          <p class="eyebrow">Un projet à documenter</p>
          <h2>Parlons de la forme que doit prendre le vôtre.</h2>
        </div>
        <a class="button button--light" href="/contact/">Prendre contact <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
