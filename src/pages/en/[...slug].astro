---
// One route renders each static English page, including /en itself.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import SeoFaq from '../../components/SeoFaq.astro';
import ClientCarousel from '../../components/ClientCarousel.astro';
import { site } from '../../data/site';

export function getStaticPaths() {
  return [
    undefined,
    'ai-automation',
    'media-creation-ai',
    'digital-project-management',
    'premium-websites',
    'work',
    'profile',
    'contact',
    'digital-consultant-nantes',
    'thank-you',
    'legal-notice',
    'privacy',
  ].map((slug) => ({ params: { slug } }));
}

const page = Astro.params.slug ?? 'home';
const metadata: Record<string, { title: string; description: string }> = {
  home: {
    title: 'Independent digital consultant & multimedia creator in Nantes',
    description: 'Kévin Barré is an independent digital professional in Nantes: media creation with AI, websites, AI training and digital project management.',
  },
  'ai-automation': { title: 'AI training and automation in Nantes', description: 'Practical AI training, workflow design and automation for teams in Nantes and remotely.' },
  'media-creation-ai': { title: 'AI-assisted music and media creation in Nantes', description: 'Music, audio, video and media creation assisted by AI, grounded in composition, editing and creative direction.' },
  'digital-project-management': { title: 'Freelance digital project management in Nantes', description: 'Scoping, coordination and delivery support for digital projects in Nantes and remotely.' },
  'premium-websites': { title: 'Websites and digital communication in Nantes', description: 'Website creation, digital communication, social media, analytics and acquisition campaigns in Nantes, with WordPress, Gutenberg and React.' },
  work: { title: 'Digital and creative work', description: 'A selection of website, digital and creative projects by Kévin Barré.' },
  profile: { title: 'Kévin Barré · digital consultant and multimedia creator', description: 'The professional background of Kévin Barré: web development, digital consulting, project management, media creation and AI.' },
  contact: { title: 'Contact · digital consulting and media creation in Nantes', description: 'Get in touch with Kévin Barré about a website, AI, media creation or digital project.' },
  'digital-consultant-nantes': { title: 'Independent digital consultant in Nantes', description: 'Media creation, AI, websites and digital project management from Nantes or remotely.' },
  'thank-you': { title: 'Thank you', description: 'Thank you for getting in touch with Kévin Barré.' },
  'legal-notice': { title: 'Legal notice', description: 'Legal notice for kbarre.fr.' },
  privacy: { title: 'Privacy', description: 'Privacy information for kbarre.fr.' },
};
const meta = metadata[page] ?? metadata.home;

const projects = [
  { number: '01', name: 'Virginia Immobilier', category: 'Real estate', role: 'Digital project · integration', text: 'A digital presence for real estate, featured here for the project and integration work.', image: '/images/projects/virginia-immobilier.webp', width: 768, height: 902 },
  { number: '02', name: 'Romy Paris', category: 'Beauty', role: 'E-commerce · web experience', text: 'An e-commerce project in the beauty sector, where the web experience and offer presentation are central.', image: '/images/projects/romy-paris.webp', width: 768, height: 790 },
  { number: '03', name: 'Oxygène Consulting', category: 'Consulting', role: 'Positioning · website', text: 'A website for a consulting activity: making the offer clear and giving the positioning a coherent form.', image: '/images/projects/oxygene-consulting.webp', width: 1024, height: 862 },
  { number: '04', name: 'Genicado', category: 'E-commerce', role: 'Design · integration', text: 'An e-commerce project that illustrates interface design and integration focused on content and use.', image: '/images/projects/genicado.webp', width: 768, height: 970 },
  { number: '05', name: 'Turgis Capital', category: 'Finance', role: 'Project management · digital presence', text: 'A digital presence in the financial sector, with a contribution to project management and online communication structure.', image: '/images/projects/turgis-capital.webp', width: 768, height: 1058 },
];
---

<BaseLayout title={meta.title} description={meta.description} locale="en">
  {page === 'home' && <>
    <section class="home-hero">
      <div class="shell home-hero__grid">
        <div class="home-hero__copy">
          <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Kévin Barré · Independent digital professional</p>
          <h1>Digital consulting.<br />Media creation.<br /><em>Useful AI.</em></h1>
          <p class="lede">I design and support digital projects, from websites to multimedia content. My work connects strategy, technology and creative practice to give strong ideas a clear form.</p>
          <div class="hero__actions"><a class="button" href="/en/contact/">Talk about a project <span aria-hidden="true">↗</span></a><a class="text-link" href="#expertise">Explore the practice <span aria-hidden="true">↓</span></a></div>
          <p class="home-hero__location">Based in Nantes · working on site and remotely.</p>
        </div>
        <div class="home-hero__art">
          <figure class="hero-photo"><img src="/images/optimized/kevin-home-development-640.webp" srcset="/images/optimized/kevin-home-development-480.webp 480w, /images/optimized/kevin-home-development-640.webp 640w, /images/optimized/kevin-home-development-960.webp 960w" sizes="(max-width: 760px) 90vw, 42vw" width="960" height="1200" alt="Kévin Barré at work" loading="eager" fetchpriority="high" decoding="async" /><figcaption><span>Kévin Barré</span><span>From intent to execution.</span></figcaption></figure>
          <div class="hero-sticker" aria-hidden="true">Create with<br />tools.<br /><strong>Keep the direction.</strong><span>↗</span></div>
          <div class="hero-note"><span class="status-dot" aria-hidden="true"></span><span><strong>15+ years</strong> in digital practice.</span></div>
          <span class="art-caption" aria-hidden="true">STRATEGY + CREATION + TECHNOLOGY</span>
        </div>
      </div>
    </section>
    <ClientCarousel locale="en" />
    <section class="section" id="expertise"><div class="shell"><div class="section-heading section-heading--split"><div><p class="eyebrow">01 / Areas of practice</p><h2>One standard.<br /><em>Several forms.</em></h2></div><p class="section-heading__text">Every project has a different entry point. The common thread is to understand the intent, choose the right tools and take care with execution.</p></div><div class="expertise-grid">
      <a class="expertise-card expertise-card--lilac" href="/en/ai-automation/"><div class="expertise-card__top"><span>01</span><span class="round-arrow" aria-hidden="true">↗</span></div><span class="expertise-card__symbol" aria-hidden="true">✳</span><h3>AI & automation</h3><p>Train teams, scope uses and build workflows that save time without handing decisions to a tool.</p><ul class="tag-list"><li>Training</li><li>Workflows</li><li>AI agents</li></ul><span class="expertise-card__link">Explore AI <span aria-hidden="true">↗</span></span></a>
      <a class="expertise-card expertise-card--peach" href="/en/media-creation-ai/"><div class="expertise-card__top"><span>02</span><span class="round-arrow" aria-hidden="true">↗</span></div><span class="expertise-card__symbol" aria-hidden="true">♫</span><h3>Media creation</h3><p>Compose, edit and direct music, sound and visual content, with or without generative AI.</p><ul class="tag-list"><li>Music</li><li>Audio & video</li><li>Suno</li></ul><span class="expertise-card__link">Discover media creation <span aria-hidden="true">↗</span></span></a>
      <a class="expertise-card expertise-card--lime" href="/en/premium-websites/"><div class="expertise-card__top"><span>03</span><span class="round-arrow" aria-hidden="true">↗</span></div><span class="expertise-card__symbol" aria-hidden="true">↗</span><h3>Web & communication</h3><p>Clarify your message and build a coherent presence across websites, social media, acquisition, analytics and editorial tools.</p><ul class="tag-list"><li>WordPress & Gutenberg</li><li>Social media</li><li>Acquisition</li></ul><span class="expertise-card__link">Explore web & communication <span aria-hidden="true">↗</span></span></a>
      <a class="expertise-card expertise-card--lilac" href="/en/digital-project-management/"><div class="expertise-card__top"><span>04</span><span class="round-arrow" aria-hidden="true">↗</span></div><span class="expertise-card__symbol" aria-hidden="true">⌁</span><h3>Project management</h3><p>Scope, translate and coordinate work across business, suppliers and technical teams.</p><ul class="tag-list"><li>Consulting</li><li>Scoping</li><li>Delivery</li></ul><span class="expertise-card__link">Explore project management <span aria-hidden="true">↗</span></span></a>
    </div></div></section>
    <section class="section work-section"><div class="shell"><div class="section-heading section-heading--split"><div><p class="eyebrow">02 / Selected work</p><h2>Projects that<br /><em>provide context.</em></h2></div><a class="arrow-link" href="/en/work/">All selected work <span class="arrow-link__glyph" aria-hidden="true">↗</span></a></div><p class="lede">The portfolio documents a contribution rather than just showing a visual. Websites, project management and creative practice are connected by the same attention to purpose and execution.</p></div></section>
    <section class="section about-section"><div class="shell about-grid"><div class="about-photo"><img src="/images/home-consultation.png" sizes="(max-width: 760px) 90vw, 40vw" width="1161" height="1354" alt="Two people discussing plans for a digital project" loading="lazy" decoding="async" /><span class="about-photo__badge">Technology works best.<br />When people work together.</span></div><div class="about-copy"><p class="eyebrow">03 / A collaborative practice</p><h2>From the brief<br />to a shared direction.</h2><p class="lede">A digital project becomes clearer when the people involved can see the same thing: the intention, the constraints and the next decision. That is where consulting, creation and technology meet.</p><a class="arrow-link" href="/en/profile/"><span>Discover the background and practice</span><span class="arrow-link__glyph" aria-hidden="true">↗</span></a></div></div></section>
    <section class="section project-start"><div class="shell project-start__inner"><p class="eyebrow">Get in touch</p><h2>A project, an idea,<br /><em>material to create?</em></h2><p>Describe the context and the intent. We can then define the most relevant way to work together.</p><div class="need-picker" aria-label="Choose a starting point"><a href="/en/contact/?request=ai">✳ <span>AI & automation</span> ↗</a><a href="/en/contact/?request=media">♫ <span>Media creation</span> ↗</a><a href="/en/contact/?request=web">↗ <span>Website</span> ↗</a><a href="/en/contact/?request=project">⌁ <span>Project management</span> ↗</a></div></div></section>
  </>}

  {page === 'ai-automation' && <>
    <PageHero eyebrow="AI & automation" title="Useful AI. Teams first." text="Practical training and automation adapted to the way your team works, so that autonomy grows without losing control." ctaHref="/en/contact/?request=ai" ctaLabel="Talk about your use cases" visual="/images/heroes/ai-automation.png" visualAlt="Screen showing an AI-agent and automation workflow" visualWidth={1122} visualHeight={1402} motif="/images/kit/code-mark.svg" />
    <section class="section section--night"><div class="shell"><SectionHeading eyebrow="AI that belongs in the work" title="Less friction. More autonomy." text="Start with tasks, documents and the people who will use the result." align="split" /><div class="service-grid"><article class="service-card"><span class="service-card__number">01</span><h3>Train for sound practice</h3><p>Accessible workshops grounded in real work situations: understand, test, question and adopt AI with judgement.</p></article><article class="service-card"><span class="service-card__number">02</span><h3>Scope before automating</h3><p>Identify genuine friction, available data, risks and the uses worth prioritising before selecting a solution.</p></article><article class="service-card"><span class="service-card__number">03</span><h3>Orchestrate workflows</h3><p>Design workflows, automations and agents that fit naturally into existing tools and habits.</p></article></div><div class="editorial-copy editorial-copy--night"><p>AI is useful when it answers a recognisable situation: finding information, preparing a first draft, structuring content or reducing repetitive work. The task is not to add another tool, but to understand what already moves between people, documents and approvals.</p><a class="text-link" href="/en/media-creation-ai/">See the media creation and AI practice <span aria-hidden="true">↗</span></a></div></div></section>
    <section class="section"><div class="shell"><SectionHeading eyebrow="A practical approach" title="Understand. Test. Take ownership." text="Training, a profession-specific workshop or support: the format follows the team." align="split" /><ol class="process-list"><li><span>01</span><strong>Map the work</strong><p>Identify repetitive tasks, information loss and opportunities that deserve real effort.</p></li><li><span>02</span><strong>Prioritise</strong><p>Choose a small number of uses that are useful, measurable and acceptable to the people involved.</p></li><li><span>03</span><strong>Prototype</strong><p>Test a workflow or assistant quickly, with safeguards and no impossible promises.</p></li><li><span>04</span><strong>Make it stick</strong><p>Train, document and adjust so a new use becomes help rather than another burden.</p></li></ol></div></section>
    <SeoFaq eyebrow="Common questions" title="Questions about AI." intro="AI creates value when the use case, data and role of people are explicit." items={[{ question: 'Who is AI training for?', answer: 'Teams that want to understand what AI can really do in their work, test it on concrete situations and keep a critical eye on the results.' }, { question: 'How do you choose a first AI automation?', answer: 'Start with a recurring task or point of friction, then check the data, confidentiality rules, approvals and expected benefit.' }, { question: 'Can training be delivered remotely?', answer: 'Yes. Workshops, scoping sessions and follow-ups can take place in Nantes or by video, with shared material and adapted exercises.' }]} />
  </>}

  {page === 'media-creation-ai' && <>
    <PageHero eyebrow="Media creation & AI" title="Create before AI. Create with it." text="My composition practice was built with conventional production and post-production tools. Generative AI, especially Suno for music, now expands the field of exploration without replacing listening, taste or direction." aside="Ableton Live · Fruity Loops / FL Studio · DaVinci Resolve · Adobe suite · Suno" ctaHref="/en/contact/?request=media" ctaLabel="Talk about a creative project" visual="/images/heroes/media-creation.png" visualAlt="Camera and multimedia creation tools on a desk" visualWidth={1122} visualHeight={1402} motif="/images/kit/waves.svg" />
    <section class="section section--night"><div class="shell"><SectionHeading eyebrow="A practice that does not begin with a prompt" title="Tools change. Attention remains." text="Composing, editing and producing are activities of choice: choosing an intention, rhythm and material, then knowing when to stop." align="split" /><div class="service-grid"><article class="service-card"><span class="service-card__number">01</span><h3>Compose and produce</h3><p>Ableton Live and Fruity Loops — now FL Studio — helped build a music practice before generative models arrived.</p></article><article class="service-card"><span class="service-card__number">02</span><h3>Edit and shape images</h3><p>DaVinci Resolve and the Adobe suite bring a culture of rhythm, post-production and finish to visual media.</p></article><article class="service-card"><span class="service-card__number">03</span><h3>Create with AI</h3><p>Suno opens a rapid space for musical exploration. Artistic direction, selection and coherence remain human choices.</p></article></div></div></section>
    <section class="section"><div class="shell"><SectionHeading eyebrow="Music creation with Suno" title="AI as an exploration partner." text="Suno can quickly open musical directions and test an intent against several interpretations. It does not remove the need for a frame or a critical eye." align="split" /><ol class="process-list"><li><span>01</span><strong>Start with an intention</strong><p>An atmosphere, emotion, rhythm, reference or intended use gives the work direction.</p></li><li><span>02</span><strong>Explore and iterate</strong><p>AI multiplies trials and comparisons. This phase still requires listening, phrasing and starting again.</p></li><li><span>03</span><strong>Select and build</strong><p>Selection holds a line, organises sequences and rejects what does not tell the right story.</p></li><li><span>04</span><strong>Finish for the medium</strong><p>Editing, arrangement, audio or video post-production and consistency checks bring the work to its audience.</p></li></ol></div></section>
    <section class="section section--muted"><div class="shell"><SectionHeading eyebrow="Sound, image and digital presence" title="Give the whole project a shared direction." text="Media creation can stand alone or enrich a broader project: a website identity, editorial content, a video piece, a sound world or an artistic experiment." align="split" /><div class="service-scope"><article><p class="eyebrow">Creative direction</p><h3>Avoid interchangeable content.</h3><p>Before producing, define what should be felt, understood or remembered. This direction keeps conventional and generative tools in service of the project’s own character.</p></article><article><p class="eyebrow">Production frame</p><h3>Make choices explicit.</h3><p>The role of AI, the sources used, expected approvals and distribution rights need to be clarified at the start of the work.</p></article></div></div></section>
    <SeoFaq eyebrow="Common questions" title="Questions about AI-assisted creation." intro="Generative tools can accelerate exploration. They do not replace a clear intent or the production choices that make a work coherent." items={[{ question: 'What role does Suno play in music creation?', answer: 'It can explore directions, atmospheres and musical material. The value of the work also lies in the brief, iteration, critical listening, selection and finishing.' }, { question: 'Why mention tools used before generative AI?', answer: 'Composition, editing and post-production provide concrete reference points for structure, rhythm, coherence, intent and finish. AI extends this practice rather than replacing it.' }, { question: 'Can media creation, websites and AI be combined?', answer: 'Yes. One project may need an editorial identity, a website, sound, visual content or a production workflow. A cross-disciplinary practice keeps a shared direction between them.' }]} />
  </>}

  {page === 'premium-websites' && <>
    <PageHero eyebrow="Websites & digital communication" title="Your presence deserves more than just a website." text="Strategy, content, design, social media, acquisition and performance: the right channels should tell the same story and make people want to follow it." ctaHref="/en/contact/?request=web" ctaLabel="Talk about your digital presence" visual="/images/heroes/web-communication.png" visualAlt="Workstation with code and a website preview" visualWidth={1672} visualHeight={941} motif="/images/kit/design-grid.svg" />
    <section class="section section--night"><div class="shell"><SectionHeading eyebrow="A presence that does its job" title="Clear, considered and built to last." text="From the first impression to the next step, every choice should help someone understand and act." align="split" /><div class="service-grid"><article class="service-card"><span class="service-card__number">01</span><h3>Clarify the presence</h3><p>Positioning, content architecture and conversion paths: the foundation before the visual layer.</p></article><article class="service-card"><span class="service-card__number">02</span><h3>Design the experience</h3><p>A readable identity and a hierarchy that make people want to read and take the next step.</p></article><article class="service-card"><span class="service-card__number">03</span><h3>Care about implementation</h3><p>A fast, accessible and maintainable website that can evolve with the activity.</p></article></div><div class="editorial-copy editorial-copy--night"><p>A website is a meeting point between an activity, a promise, content and visitors who may not know the work yet. It starts with what they need to understand, find and be able to do.</p></div></div></section>
    <section class="section section--muted" id="wordpress-headless"><div class="shell"><SectionHeading eyebrow="Headless WordPress, Gutenberg & React" title="Front-end freedom. Gutenberg autonomy." text="With fifteen years of CMS experience, especially WordPress, I can design an architecture where Gutenberg remains the editorial team’s familiar tool while a React interface delivers the public experience." align="split" /><div class="service-scope"><article><p class="eyebrow">Gutenberg for content</p><h3>A visual, guided and flexible back office.</h3><p>Pages, news, media and structured content are managed with Gutenberg. Custom blocks and controlled compositions give teams the freedom to publish without letting them rebuild the interface or requiring a developer for every update.</p></article><article><p class="eyebrow">React for the experience</p><h3>An interface beyond the limits of a theme.</h3><p>A React front-end consumes the content exposed by WordPress and makes room for bespoke components, specific journeys, deliberate interactions and fine control over the interface. The separation can also make each side easier to evolve.</p></article></div><div class="editorial-copy"><p>The recommended starting point is a restrained Gutenberg system: a focused set of custom blocks, composition patterns and clear editorial rules. It gives useful autonomy without turning the back office into an unlimited page builder. WordPress then exposes this content to the React interface through its API.</p><p>Headless architecture is not about disconnecting WordPress to follow a trend. It becomes relevant when a website needs a very specific experience, several distribution points or a front-end that must evolve independently from the back office. For a simple editorial site, a well-built WordPress with Gutenberg can remain the most sensible option.</p></div></div></section>
    <section class="section"><div class="shell"><SectionHeading eyebrow="Technical choices" title="Choose the right level of complexity." text="The best stack depends on the content, publishing frequency, expected autonomy and integrations — not on a tool being fashionable." align="split" /><ol class="process-list"><li><span>01</span><strong>Performance</strong><p>A fast experience on mobile, optimised media and only the JavaScript that serves a real purpose.</p></li><li><span>02</span><strong>Visibility</strong><p>A sound SEO base: structure, content, metadata, sitemap and redirects.</p></li><li><span>03</span><strong>Autonomy</strong><p>Content structured so that it can evolve without a heavy or confusing editorial process.</p></li><li><span>04</span><strong>Care</strong><p>Every interface detail should support understanding, trust or the next useful action.</p></li></ol></div></section>
    <SeoFaq eyebrow="Common questions" title="Questions about websites." intro="A high-quality website is not just a technology or a mock-up: it starts with what visitors need to understand and do." items={[{ question: 'Should WordPress be kept during a redesign?', answer: 'Not automatically. The answer depends on the site’s role, content, integrations, expected autonomy and performance needs. A redesign begins with the needs, not with a tool change for its own sake.' }, { question: 'Why combine headless WordPress and React?', answer: 'The architecture separates the CMS from the front-end. WordPress remains the editorial back office while React can be designed around a bespoke experience. It is useful when journeys or distribution points need more freedom than a traditional theme, without losing publishing autonomy.' }, { question: 'Can a website be created remotely?', answer: 'Yes. Scoping, content workshops, reviews and project follow-up can be carried out remotely with shared material and clear decision points.' }]} />
  </>}

  {page === 'premium-websites' && <section class="section" id="digital-communication-social-media"><div class="shell"><SectionHeading eyebrow="Digital communication & social media" title="Make a presence live, not just publish it." text="A website, social account, campaign or business tool does not work in isolation. The aim is to create communication that is coherent, measurable and suited to the people you want to reach." align="split" /><div class="service-grid"><article class="service-card"><span class="service-card__number">01</span><h3>Structure the channels</h3><p>Positioning, editorial guidelines, social accounts and content formats: each channel has its role, but all should remain recognisable and connected to the activity.</p></article><article class="service-card"><span class="service-card__number">02</span><h3>Measure what matters</h3><p>Setting up analytics, following relevant signals and understanding journeys makes it possible to decide from evidence rather than publish or invest blindly.</p></article><article class="service-card"><span class="service-card__number">03</span><h3>Grow the audience</h3><p>Designing and following acquisition or follower-growth campaigns requires a clear audience, suitable content, a controlled budget and regular adjustments.</p></article></div><div class="service-scope communication-scope"><article><p class="eyebrow">Accounts & campaigns</p><h3>Move from scattered presence to a readable system.</h3><p>Social account support, content organisation, campaign preparation and results review aim for a presence that develops over time, without confusing visibility with automatic results.</p></article><article><p class="eyebrow">ERP & business tools</p><h3>Make information flow to the right place.</h3><p>ERP and connected-tool configuration should serve the team: more reliable data, better followed stages and continuity between communication, customer relationships and operations.</p></article></div><div class="editorial-copy"><p>Digital communication is not a sequence of disconnected posts. It connects the website, social media, campaigns, content and the tools used to observe what happens next. This continuity makes a presence clearer for the audience and easier for a team to steer.</p></div></div></section>}

  {page === 'digital-project-management' && <>
    <PageHero eyebrow="Digital project management" title="A clear course. A project that moves." text="I connect teams, objectives and technology. From scoping to delivery, the direction remains visible." ctaHref="/en/contact/?request=project" ctaLabel="Talk about your project" visual="/images/heroes/project-management.png" visualAlt="Project board with a backlog, priorities and work in progress" visualWidth={1536} visualHeight={1024} motif="/images/kit/waves.svg" />
    <section class="section section--night"><div class="shell"><SectionHeading eyebrow="A partner for clarity" title="The right people. The same direction." text="A framework for deciding, moving forward and bringing users into the work." align="split" /><div class="service-grid"><article class="service-card"><span class="service-card__number">01</span><h3>Scope the project</h3><p>Clarify objectives, scope, stakeholders and the criteria that define a successful delivery.</p></article><article class="service-card"><span class="service-card__number">02</span><h3>Connect the work</h3><p>Translate business needs into requests technical teams can work with — and back again.</p></article><article class="service-card"><span class="service-card__number">03</span><h3>Keep the course</h3><p>Prioritise, coordinate, report and resolve blockers without losing sight of adoption.</p></article></div><div class="editorial-copy editorial-copy--night"><p>Project management does not add meetings or reporting for their own sake. It makes decisions, dependencies and points requiring arbitration visible, so everyone knows why they are involved and what comes next.</p></div></div></section>
    <section class="section section--muted" id="leadership-outcomes"><div class="shell"><SectionHeading eyebrow="Outcome-led project leadership" title="Move forward. Keep the evidence." text="My role is not to circulate more boards and reports. It is to make clear what has been decided, what is still uncertain and what has actually been validated, so a project can keep moving without losing its context." align="split" /><div class="service-grid service-grid--four"><article class="service-card"><span class="service-card__number">01</span><h3>Turn ambiguity into an actionable path</h3><p>I turn objectives, constraints and unknowns into scope, priorities, dependencies and success criteria. The team gets a frame for decisions and delivery, not just another task list.</p></article><article class="service-card"><span class="service-card__number">02</span><h3>Parallel work, one direction</h3><p>When several workstreams can move at the same time, I clarify ownership and dependencies and bring them back to shared decision and validation points. The goal is not to keep everyone busy; it is to prevent conflicts and late blockers.</p></article><article class="service-card"><span class="service-card__number">03</span><h3>Progress is not proof</h3><p>A “done” status is not a substitute for verification. I keep delivered, validated, blocked, ambiguous and still-to-decide work distinct so the next decision reflects the actual state of the project.</p></article><article class="service-card"><span class="service-card__number">04</span><h3>Resume without starting over</h3><p>Priorities, pace and contributors change. Before restarting, I reconstruct the useful state: what exists, what is still reliable, what needs confirmation and the next concrete action.</p></article></div><div class="editorial-copy"><p>This approach is especially useful when a project spans business needs, suppliers and technical work. A developer background combined with project-management experience helps me translate constraints without hiding trade-offs, so each person can see what they need to decide, deliver or validate.</p><p><strong>More than fifteen years of digital practice</strong>, including several years in Web and digital project management and freelance work since 2014.</p><a class="text-link" href="/en/project-leadership/">Explore the full project-leadership approach <span aria-hidden="true">↗</span></a></div></div></section>
    <section class="section"><div class="shell"><SectionHeading eyebrow="A readable trajectory" title="From the first idea to everyday use." text="The method adapts to the size and maturity of the project, but these four subjects always deserve attention." align="split" /><ol class="process-list"><li><span>01</span><strong>The need</strong><p>Interviews, context, priorities and risks.</p></li><li><span>02</span><strong>The roadmap</strong><p>Scope, deliverables, estimates, rhythm and governance.</p></li><li><span>03</span><strong>Delivery</strong><p>Coordination, trade-offs, acceptance and useful communication.</p></li><li><span>04</span><strong>What follows</strong><p>Training, documentation, maintenance and continuous improvement.</p></li></ol><div class="editorial-copy"><p>Projects rarely move in a perfectly straight line. Priorities change, technical questions surface and users reveal new needs. The aim is to record these changes without losing the initial purpose or trapping a team in a plan that no longer fits.</p></div></div></section>
    <SeoFaq eyebrow="Common questions" title="Questions about project management." intro="A freelance project management role should create movement and clarity, not another layer of administration." items={[{ question: 'When should a freelance project manager get involved?', answer: 'When a project remains unclear, several people must be coordinated, delivery is approaching or a drifting trajectory needs to be rebuilt.' }, { question: 'What can scoping deliver?', answer: 'Depending on the context, it can result in a roadmap, a needs document, user journeys, priorities, acceptance criteria or a coordination plan.' }, { question: 'Can a digital project be managed remotely?', answer: 'Yes. Focused workshops, a known follow-up rhythm, recorded decisions and shared documents work well with distributed teams.' }]} />
  </>}

