---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowLink from '../components/ArrowLink.astro';
import ClientCarousel from '../components/ClientCarousel.astro';
import { site } from '../data/site';

const services = [
  { number: '01', title: 'IA & automatisation', text: 'Former, cadrer et construire des usages qui font gagner du temps sans transférer la décision à un outil.', tags: ['Formation', 'Workflows', 'Agents IA'], href: '/ia-automatisation/', icon: '✳', theme: 'lilac', label: 'Voir l’approche IA' },
  { number: '02', title: 'Création média', text: 'Composer, monter et donner une direction à des contenus sonores, visuels et musicaux, avec ou sans IA générative.', tags: ['Musique', 'Audio & vidéo', 'Suno'], href: '/creation-media-ia/', icon: '♫', theme: 'peach', label: 'Découvrir la création média' },
  { number: '03', title: 'Web & communication', text: 'Clarifier ce que vous avez à dire et déployer une présence cohérente : site, réseaux sociaux, acquisition, analyse et outils éditoriaux.', tags: ['WordPress & Gutenberg', 'Social media', 'Acquisition'], href: '/sites-web-premium/', icon: '↗', theme: 'lime', label: 'Voir l’approche Web & communication' },
  { number: '04', title: 'Pilotage de projet', text: 'Cadrer, traduire et coordonner pour faire avancer un projet entre métiers, prestataires et équipes techniques.', tags: ['Conseil', 'Cadrage', 'Pilotage'], href: '/pilotage-digital/', icon: '⌁', theme: 'lilac', label: 'Voir l’approche projet' },
];
const projects = [
  { name: 'Virginia Immobilier', type: 'Immobilier · Projet numérique', image: 'virginia-immobilier' },
  { name: 'Romy Paris', type: 'Beauté · E-commerce', image: 'romy-paris' },
  { name: 'Oxygène Consulting', type: 'Conseil · Site web', image: 'oxygene-consulting' },
];
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'KBarre',
  url: site.url,
  logo: new URL('/favicon.svg', site.url).href,
  founder: {
    '@type': 'Person',
    name: site.person,
  },
  email: site.email,
  telephone: site.phoneHref,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '28 rue d’Allonville',
    postalCode: '44000',
    addressLocality: 'Nantes',
    addressCountry: 'FR',
  },
};
const steps = [
  ['01', 'Comprendre le contexte', 'Le besoin, les personnes impliquées, les contraintes et ce qui mérite vraiment d’être résolu.'],
  ['02', 'Donner une forme', 'Un contenu, un parcours, un prototype ou une feuille de route : la bonne forme dépend du sujet.'],
  ['03', 'Travailler avec exigence', 'Des choix lisibles, des retours concrets et des outils mis au service de l’intention, pas l’inverse.'],
  ['04', 'Transmettre et poursuivre', 'Des livrables compréhensibles et une autonomie suffisante pour que le travail reste utile après la mission.'],
];
---

<BaseLayout title="Consultant numérique indépendant & créateur multimédia à Nantes" description="Kévin Barré, professionnel indépendant à Nantes : conseil numérique, création média assistée par IA, sites Web et pilotage de projet." structuredData={organizationSchema}>
  <section class="home-hero">
    <div class="shell home-hero__grid">
      <div class="home-hero__copy">
        <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Kévin Barré · Consultant numérique indépendant</p>
        <h1>Conseil numérique.<br />Création média.<br /><em>IA utile.</em><svg class="headline-spark" viewBox="0 0 80 80" fill="none" aria-hidden="true"><path d="M40 3v74M3 40h74M14 14l52 52M14 66l52-52" stroke="currentColor" stroke-width="9" /></svg></h1>
        <p class="lede">Je conçois et j’accompagne des projets numériques, du site Web au contenu multimédia. Mon travail relie la stratégie, la technique et la création pour donner une forme claire aux bonnes idées.</p>
        <div class="hero__actions">
          <a class="button" href="/contact/">Parlons de votre projet <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="#expertises">Explorer les expertises <span aria-hidden="true">↓</span></a>
        </div>
        <p class="home-hero__location">Basé à Nantes · collaborations sur site et à distance.</p>
      </div>
      <div class="home-hero__art">
        <figure class="hero-photo">
          <img src="/images/optimized/kevin-home-development-640.webp" srcset="/images/optimized/kevin-home-development-480.webp 480w, /images/optimized/kevin-home-development-640.webp 640w, /images/optimized/kevin-home-development-960.webp 960w" sizes="(max-width: 760px) 90vw, 42vw" width="960" height="1200" alt="Kévin Barré à son poste de travail" loading="eager" fetchpriority="high" decoding="async" />
          <figcaption><span>Kévin Barré</span><span>Du conseil au concret.</span></figcaption>
        </figure>
        <div class="hero-sticker" aria-hidden="true">Créer avec<br />des outils.<br /><strong>Garder le cap.</strong><span>↗</span></div>
        <div class="hero-note"><span class="status-dot" aria-hidden="true"></span><span><strong>15+ ans</strong> de pratique numérique.</span></div>
        <span class="art-caption" aria-hidden="true">STRATÉGIE + CRÉATION + TECHNOLOGIE</span>
      </div>
    </div>
  </section>

  <ClientCarousel />

  <section class="section" id="expertises">
    <div class="shell">
      <div class="section-heading section-heading--split">
        <div><p class="eyebrow">01 / Domaines de pratique</p><h2>Une même exigence.<br /><em>Plusieurs formes.</em></h2></div>
        <p class="section-heading__text">Chaque projet a son point d’entrée. Le fil commun reste le même : comprendre l’intention, choisir les bons outils et soigner l’exécution.</p>
      </div>
      <div class="expertise-grid">
        {services.map(service => <a class:list={['expertise-card', 'expertise-card--' + service.theme]} href={service.href}>
          <div class="expertise-card__top"><span>{service.number}</span><span class="round-arrow" aria-hidden="true">↗</span></div>
          <span class="expertise-card__symbol" aria-hidden="true">{service.icon}</span>
          <h3>{service.title}</h3><p>{service.text}</p>
          <ul class="tag-list">{service.tags.map(tag => <li>{tag}</li>)}</ul>
          <span class="expertise-card__link">{service.label} <span aria-hidden="true">↗</span></span>
        </a>)}
      </div>
    </div>
  </section>

  <section class="section work-section">
    <div class="shell">
      <div class="section-heading section-heading--split">
        <div><p class="eyebrow">02 / Sélection de projets</p><h2>Des réalisations<br /><em>qui donnent le contexte.</em></h2></div>
        <ArrowLink href="/realisations/" label="Toutes les réalisations" />
      </div>
      <div class="work-grid">
        {projects.map((project, index) => <a class:list={['work-card', 'work-card--' + index]} href={'/realisations/#' + project.image}>
          <div class="work-card__image"><img src={'/images/optimized/' + project.image + '-640.webp'} srcset={'/images/optimized/' + project.image + '-480.webp 480w, /images/optimized/' + project.image + '-640.webp 640w, /images/optimized/' + project.image + '-768.webp 768w'} sizes="(max-width: 760px) calc(100vw - 5.5rem), (max-width: 1440px) 28vw, 375px" width="768" height="900" alt={'Aperçu du site ' + project.name} loading="lazy" decoding="async" /><span class="round-arrow" aria-hidden="true">↗</span></div>
          <div class="work-card__meta"><h3>{project.name}</h3><p>{project.type}</p></div>
        </a>)}
      </div>
    </div>
  </section>

  <section class="section about-section">
    <div class="shell about-grid">
      <div class="about-photo"><img src="/images/home-consultation.png" sizes="(max-width: 760px) 90vw, 40vw" width="1161" height="1354" alt="Deux personnes échangent autour des plans d’un projet numérique" loading="lazy" decoding="async" /><span class="about-photo__badge">La tech, c’est bien.<br />Ensemble, c’est mieux.</span></div>
      <div class="about-copy"><p class="eyebrow">03 / Une pratique hybride</p><h2>Du code à l’image.<br />Du brief à la forme.</h2><p class="lede">Développeur de formation, consultant par expérience et compositeur dans ma pratique créative, je passe volontiers d’un sujet à l’autre. Cette culture transversale m’aide à faire dialoguer une intention, un public et les moyens techniques disponibles.</p><div class="about-facts"><div><strong>15+</strong><span>ans dans le numérique</span></div><div><strong>FR / EN</strong><span>pour collaborer</span></div></div><ArrowLink href="/profil/" label="Découvrir le parcours et la pratique" /></div>
    </div>
  </section>

  <section class="section method-section">
    <div class="shell"><div class="section-heading"><p class="eyebrow">04 / Une manière de travailler</p><h2>Du discernement,<br /><em>puis du concret.</em></h2></div><div class="home-method">{steps.map(([number, title, text]) => <article><span class="step-marker">{number}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div>
  </section>

  <section class="section project-start" aria-labelledby="start-title">
    <div class="shell project-start__inner"><p class="eyebrow">Prendre contact</p><h2 id="start-title">Un projet, une idée,<br /><em>une matière à créer ?</em></h2><p>Décrivez le contexte et l’intention. Nous pourrons définir le format de collaboration le plus pertinent.</p>
      <div class="need-picker" aria-label="De quoi avez-vous besoin ?">
        <a href="/contact/?demande=ia">✳ <span>IA & automatisation</span> ↗</a><a href="/contact/?demande=media">♫ <span>Création média</span> ↗</a><a href="/contact/?demande=web">↗ <span>Site Web</span> ↗</a><a href="/contact/?demande=pilotage">⌁ <span>Pilotage de projet</span> ↗</a>
      </div>
      <a class="text-link" href={'mailto:' + site.email}>Ou simplement, dites bonjour <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
