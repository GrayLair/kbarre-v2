---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Message envoyé" description="Votre demande a bien été envoyée à Kévin Barré." robots="noindex,follow">
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">Message envoyé</p>
      <h1>Merci pour votre message.</h1>
      <p class="lede">Merci pour votre demande. Je vous répondrai dès que possible. En attendant, vous pouvez découvrir mes expertises ou mon parcours.</p>
      <div class="hero__actions">
        <a class="button" href="/ia-automatisation">Explorer les expertises <span aria-hidden="true">↗</span></a>
        <a class="button button--outline" href="/profil">Voir mon profil <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
