---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PracticeNotes from '../components/PracticeNotes.astro';

const experience = [
  {
    dates: 'Depuis 2023',
    title: 'Data Service Specialist · Telus AI',
    text: 'Évaluation et correction de données et de productions IA, avec une exigence de cohérence, de précision et de respect des consignes.',
  },
  {
    dates: 'Depuis 2014',
    title: 'Concepteur Web freelance',
    text: 'Création et refonte de sites, conseil numérique, SEO/SEA, maintenance et accompagnement de TPE/PME.',
  },
  {
    dates: '2017 — 2022',
    title: 'Chef de projets Web & numérique',
    text: 'CBM Web puis Agence ICommunication : cadrage, coordination, spécifications, conseil, maintenance et formation.',
  },
  {
    dates: '2015 — 2017',
    title: 'Développeur Web · CBM Web',
    text: 'Développement front-end et back-end dans un environnement Ruby on Rails.',
  },
  {
    dates: '2011 — 2013',
    title: 'Développeur Web · Atophisse Conseil',
    text: 'Développement Drupal/PHP en alternance, première expérience professionnelle dans le Web.',
  },
];

const expertise = [
  {
    number: '01',
    title: 'Projet & conseil',
    text: 'Cadrage, analyse fonctionnelle, estimation, planification, coordination transverse, reporting et relation client.',
  },
  {
    number: '02',
    title: 'Web & acquisition',
    text: 'Quinze ans de pratique CMS, notamment WordPress et Gutenberg : e-commerce, communication numérique, réseaux sociaux, analytics, acquisition et architectures headless React.',
  },
  {
    number: '03',
    title: 'IA & qualité',
    text: 'Formation, workflows et agents, évaluation de données, contrôle qualité, rigueur des consignes et reporting.',
  },
  {
    number: '04',
    title: 'Création média',
    text: 'Composition, production audio, montage et expérimentation assistée par IA : une pratique qui relie intention, rythme et finition.',
  },
];
---

<BaseLayout
  title="Profil de Kévin Barré · consultant numérique et créateur multimédia"
  description="Le parcours de Kévin Barré : conseil numérique, développement Web, pilotage de projet, création média et pratique de l’IA."
>
  <PageHero
    eyebrow="Kévin Barré · Le parcours"
    title="Une pratique numérique, technique et créative."
    text="Développeur, chef de projet, consultant, compositeur et praticien de l’IA : plus de quinze ans à relier les besoins, les outils et les formes que prennent les projets."
    ctaHref="/contact/"
    ctaLabel="Parler d’une collaboration"
    visual="/images/heroes/profile-kevin.png"
    visualAlt="Portrait de Kévin Barré"
    visualWidth={1122}
    visualHeight={1402}
    motif="/images/kit/cursor.svg"
  />

  <section class="section section--muted">
    <div class="shell profile-intro">
      <div>
        <p class="eyebrow">En bref</p>
        <h2>Relier les points, c’est mon métier.</h2>
      </div>
      <div>
        <p class="lede">
          Mon parcours de développeur me permet de dialoguer avec les équipes techniques.
          Mes années de conseil et de pilotage m’ont appris à écouter les métiers, à
          structurer les besoins et à donner un cadre utile aux décisions.
        </p>
        <p class="lede">
          Ma pratique créative nourrit le même regard : une bonne solution ne consiste pas
          seulement à produire. Elle doit avoir une intention, une cohérence et une forme
          que les personnes concernées peuvent réellement s’approprier.
        </p>
      </div>
      <aside class="profile-intro__meta">
        <div><span>Localisation</span><strong>Nantes · France · À distance</strong></div>
        <div><span>Langues</span><strong>Français et anglais · C2</strong></div>
        <div><span>Formats de collaboration</span><strong>Conseil, conception, renfort, atelier, accompagnement</strong></div>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHeading
        eyebrow="Expertises"
        title="Quatre cultures, un même regard."
        text="Le code pour comprendre. Le conseil pour décider. La création pour donner une forme. La transmission pour faire durer."
        align="split"
      />
      <div class="service-grid service-grid--four">
        {expertise.map((item) => (
          <article class="service-card">
            <span class="service-card__number">{item.number}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--muted">
    <div class="shell">
      <SectionHeading
        eyebrow="Pratique créative"
        title="Composer, monter, explorer."
        text="La création média fait partie de mon parcours en parallèle des projets numériques. Elle s’est développée avec les outils de composition, d’audio et de postproduction avant de s’ouvrir aux outils génératifs."
        align="split"
      />
      <div class="service-scope">
        <article>
          <p class="eyebrow">Avant l’IA générative</p>
          <h3>Une culture des outils de création.</h3>
          <p>Ableton Live, Fruity Loops / FL Studio, DaVinci Resolve et la suite Adobe ont construit une pratique de la composition, du rythme, du montage et de la finition. Ils restent les repères qui permettent d’évaluer un résultat au-delà de l’effet immédiat.</p>
        </article>
        <article>
          <p class="eyebrow">Aujourd’hui</p>
          <h3>L’IA comme espace d’itération.</h3>
          <p>La création accompagnée par IA, notamment musicale avec Suno, permet d’explorer rapidement des directions. Le choix des essais, la direction artistique et la recherche de cohérence restent au centre du travail.</p>
        </article>
      </div>
      <a class="text-link" href="/creation-media-ia/">Voir l’approche création média <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="section section--night">
    <div class="shell">
      <SectionHeading
        eyebrow="Parcours"
        title="Le fil de mon parcours."
        align="split"
      />
      <ol class="timeline">
        {experience.map((item) => (
          <li>
            <time>{item.dates}</time>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="callout">
        <div>
          <p class="eyebrow">Travailler ensemble</p>
          <h2>Un projet qui demande à la fois du fond et de la forme ?</h2>
        </div>
        <a class="button button--light" href="/contact/">Me contacter <span aria-hidden="true">↗</span></a>
      </div>
      <p class="profile-recruiter-note">Vous évaluez un profil pour une mission ou un poste ? Retrouvez le parcours détaillé ci-dessus, ou <a href="https://www.linkedin.com/in/k%C3%A9vin-barr%C3%A9-324610148/" target="_blank" rel="noopener noreferrer">consultez LinkedIn ↗</a>.</p>
    </div>
  </section>
  <PracticeNotes focus="profile" />
</BaseLayout>
