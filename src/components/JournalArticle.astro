---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { visibleJournalEntries, journalPath, journalDocuments, isJournalPublished, readingMinutes, type JournalEntry } from '../data/journal';
import type { Locale } from '../data/i18n';

interface Props { entry: JournalEntry; locale?: Locale; }
const { entry, locale = 'fr' } = Astro.props;
const copy = entry.copy[locale];
const document = journalDocuments(entry, locale);
const published = isJournalPublished(entry);
const en = locale === 'en';
const indexPath = en ? '/en/blog/' : '/blog/';
const date = new Intl.DateTimeFormat(en ? 'en-GB' : 'fr-FR', { dateStyle: 'long', timeZone: 'UTC' })
  .format(new Date(`${entry.publishedAt ?? entry.preparedAt}T00:00:00Z`));
const url = new URL(journalPath(entry, locale), site.url).href;
const sources = copy.sources ?? [];
const sourceNumber = (sourceUrl: string) => sources.findIndex(source => source.url === sourceUrl) + 1;
const relatedEntries = visibleJournalEntries.filter(other => other.id !== entry.id)
  .sort((a, b) => Number(b.copy[locale].category === copy.category) - Number(a.copy[locale].category === copy.category))
  .slice(0, 3);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: copy.title,
  description: copy.description,
  datePublished: entry.publishedAt,
  author: { '@type': 'Person', name: site.person, url: new URL(en ? '/en/profile/' : '/profil/', site.url).href },
  mainEntityOfPage: url,
  url,
  inLanguage: locale,
  image: new URL('/social-cover.svg', site.url).href,
};
---

<BaseLayout title={document.seoTitle ?? document.title} description={document.seoDescription} structuredData={published ? schema : undefined} locale={locale} ogType="article" publishedTime={schema.datePublished} robots={document.noindex ? 'noindex,nofollow' : undefined}>
  <article class="journal-article shell">
    <header class="journal-article__header">
      <a class="text-link" href={indexPath}>← {en ? 'All articles' : 'Tous les articles'}</a>
      <p class="eyebrow">{copy.category}</p>
      <h1>{copy.title}</h1>
      {!published && <p class="journal-review">{en ? 'Editorial preview — awaiting final review.' : 'Prévisualisation éditoriale — en attente de relecture finale.'}</p>}
      <p class="journal-meta">{site.person} · <time datetime={entry.publishedAt ?? entry.preparedAt}>{date}</time> · {readingMinutes(copy)} min {en ? 'read' : 'de lecture'}</p>
      <p class="lede">{copy.introduction}</p>
    </header>
    <nav class="journal-contents" aria-label={en ? 'On this page' : 'Sommaire de l’article'}>
      <p class="eyebrow">{en ? 'On this page' : 'Dans cet article'}</p>
      <ol>{copy.sections.map((section, i) => <li><a href={`#section-${i + 1}`}>{section.title}</a></li>)}</ol>
    </nav>
    <div class="journal-body">
      {copy.sections.map((section, i) => <section id={`section-${i + 1}`}>
        <h2>{section.title}</h2>
        {section.paragraphs.map(paragraph => <p>{paragraph}</p>)}
        {section.checklist && <ul>{section.checklist.map(item => <li>{item}</li>)}</ul>}
        {Boolean(section.sourceUrls?.length) && <p class="journal-citations">
          {en ? 'References for this section: ' : 'Repères pour cette section : '}
          {section.sourceUrls?.map(sourceUrl => <a href={`#source-${sourceNumber(sourceUrl)}`} aria-label={`Source ${sourceNumber(sourceUrl)}`}>[{sourceNumber(sourceUrl)}]</a>)}
        </p>}
      </section>)}
      <aside class="journal-takeaway">
        <h2>{en ? 'A first step for your project' : 'Un premier pas pour votre projet'}</h2>
        <p>{copy.takeaway}</p>
        <a class="text-link" href={copy.service.href}>{copy.service.label} <span aria-hidden="true">↗</span></a>
      </aside>
      {sources.length > 0 && <section class="journal-sources" aria-labelledby="article-sources">
        <h2 id="article-sources">{en ? 'Sources and further reading' : 'Sources et prolongements'}</h2>
        <p>{en ? 'The references support the factual points discussed above. Examples and decision frameworks are editorial proposals; they do not establish a result for your own project.' : 'Ces références étayent les points factuels discutés dans le texte. Les exemples et cadres de décision sont des propositions éditoriales ; ils ne démontrent pas un résultat pour votre propre projet.'}</p>
        <ol>{sources.map((source, i) => <li id={`source-${i + 1}`}>
          <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} <span aria-hidden="true">↗</span></a>
          <span class="journal-source-meta">{source.publisher} · {en ? 'consulted' : 'consulté le'} <time datetime={source.accessedAt}>{new Intl.DateTimeFormat(en ? 'en-GB' : 'fr-FR', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(`${source.accessedAt}T00:00:00Z`))}</time></span>
        </li>)}</ol>
      </section>}
      {Boolean(copy.inspiration?.length) && <aside class="journal-inspiration" aria-labelledby="article-inspiration">
        <h2 id="article-inspiration">{en ? 'Editorial inspiration' : 'Pistes de veille'}</h2>
        <p>{en ? 'These AI Explained videos explore related themes and offer further questions to consider. The article develops its own analysis and uses the sources listed above for factual claims.' : 'Ces vidéos d’AI Explained abordent des thèmes proches et proposent d’autres questions à explorer. L’article développe sa propre analyse et s’appuie sur les sources ci-dessus pour les affirmations factuelles.'}</p>
        <ul>{copy.inspiration?.map(video => <li><a href={video.url} target="_blank" rel="noopener noreferrer">{video.title} <span aria-hidden="true">↗</span></a>{video.publishedAt && <span class="journal-source-meta">{video.publishedAt}</span>}</li>)}</ul>
      </aside>}
    </div>
  </article>
  <section class="section section--muted" aria-labelledby="related-articles">
    <div class="shell">
      <h2 id="related-articles">{en ? 'Continue reading' : 'Poursuivre la lecture'}</h2>
      <ul class="journal-related">{relatedEntries.map(other =>
        <li><a class="text-link" href={journalPath(other, locale)}>{other.copy[locale].title} <span aria-hidden="true">↗</span></a></li>
      )}</ul>
    </div>
  </section>
</BaseLayout>
