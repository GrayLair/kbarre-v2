---
import type { Locale } from '../data/i18n';

interface Props { compact?: boolean; locale?: Locale; }
const { compact = false, locale = 'fr' } = Astro.props;
const href = locale === 'en' ? '/en' : '/';
const label = locale === 'en' ? "Ꝃ'Barré — home" : "Ꝃ'Barré — accueil";
---

<a class:list={['brand', { 'brand--compact': compact }]} href={href} aria-label={label}>
  <span class="brand__mark" aria-hidden="true">Ꝃ.</span>
  <span class="brand__name">barré</span>
</a>
