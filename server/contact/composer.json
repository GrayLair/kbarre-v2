{
  "name": "kbarre/contact",
  "description": "Self-hosted contact protection for the static KBarre site",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "ext-mbstring": "*",
    "altcha-org/altcha": "2.3.0"
  },
  "autoload": {
    "psr-4": {
      "Kbarre\\Contact\\": "src/"
    }
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.1.0"
    },
    "allow-plugins": false
  }
}

